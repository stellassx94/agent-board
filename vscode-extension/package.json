{
	"name": "agent-board-sidebar",
	"displayName": "Agent Board Sidebar",
	"description": "Compact sidebar list of your Claude Code and Codex sessions, fed by the local Agent Board.",
	"version": "0.4.23",
	"icon": "media/logo.png",
	"publisher": "stella-simsx",
	"private": true,
	"license": "UNLICENSED",
	"engines": {
		"vscode": "^1.85.0"
	},
	"categories": [
		"Other"
	],
	"main": "./extension.js",
	"activationEvents": [
		"onStartupFinished"
	],
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "agentBoard",
					"title": "Agent Board",
					"icon": "media/icon.svg"
				}
			]
		},
		"views": {
			"agentBoard": [
				{
					"type": "webview",
					"id": "agentBoard.overview",
					"name": "Overview",
					"initialSize": 1
				},
				{
					"id": "agentBoard.sessions",
					"name": "Sessions",
					"initialSize": 5
				}
			]
		},
		"commands": [
			{
				"command": "agentBoard.refresh",
				"title": "Refresh",
				"icon": "$(refresh)"
			},
			{
				"command": "agentBoard.open",
				"title": "Open session"
			},
			{
				"command": "agentBoard.resumeNew",
				"title": "Handoff to new session",
				"icon": "$(export)"
			},
			{
				"command": "agentBoard.openBoard",
				"title": "Open full board in browser",
				"icon": "$(link-external)"
			},
			{
				"command": "agentBoard.search",
				"title": "Search sessions",
				"icon": "$(search)"
			},
			{
				"command": "agentBoard.clearSearch",
				"title": "Clear search",
				"icon": "$(clear-all)"
			},
			{
				"command": "agentBoard.markDone",
				"title": "Mark done",
				"icon": "$(check)"
			},
			{
				"command": "agentBoard.undoDone",
				"title": "Undo done",
				"icon": "$(discard)"
			},
			{
				"command": "agentBoard.continueLater",
				"title": "Continue later",
				"icon": "$(clock)"
			},
			{
				"command": "agentBoard.clearContinue",
				"title": "Remove from Continue later",
				"icon": "$(close)"
			},
			{
				"command": "agentBoard.toggleGroupBy",
				"title": "Group by status or topic",
				"icon": "$(list-tree)"
			},
			{
				"command": "agentBoard.pick",
				"title": "Pick a session by status"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "agentBoard.toggleGroupBy",
					"when": "view == agentBoard.sessions",
					"group": "navigation@0"
				},
				{
					"command": "agentBoard.search",
					"when": "view == agentBoard.sessions",
					"group": "navigation@1"
				},
				{
					"command": "agentBoard.clearSearch",
					"when": "view == agentBoard.sessions && agentBoard.searching",
					"group": "navigation@2"
				},
				{
					"command": "agentBoard.refresh",
					"when": "view == agentBoard.sessions",
					"group": "navigation@3"
				},
				{
					"command": "agentBoard.openBoard",
					"when": "view == agentBoard.sessions",
					"group": "navigation@4"
				}
			],
			"commandPalette": [
				{
					"command": "agentBoard.open",
					"when": "false"
				},
				{
					"command": "agentBoard.resumeNew",
					"when": "false"
				},
				{
					"command": "agentBoard.markDone",
					"when": "false"
				},
				{
					"command": "agentBoard.undoDone",
					"when": "false"
				},
				{
					"command": "agentBoard.continueLater",
					"when": "false"
				},
				{
					"command": "agentBoard.clearContinue",
					"when": "false"
				},
				{
					"command": "agentBoard.pick",
					"when": "false"
				}
			],
			"view/item/context": [
				{
					"command": "agentBoard.resumeNew",
					"when": "view == agentBoard.sessions && viewItem =~ /^session/",
					"group": "inline@0"
				},
				{
					"command": "agentBoard.resumeNew",
					"when": "view == agentBoard.sessions && viewItem =~ /^session/",
					"group": "1_actions@0"
				},
				{
					"command": "agentBoard.continueLater",
					"when": "view == agentBoard.sessions && viewItem =~ /done=0.*cont=0/",
					"group": "inline@1"
				},
				{
					"command": "agentBoard.clearContinue",
					"when": "view == agentBoard.sessions && viewItem =~ /done=0.*cont=1/",
					"group": "inline@1"
				},
				{
					"command": "agentBoard.markDone",
					"when": "view == agentBoard.sessions && viewItem =~ /done=0/",
					"group": "inline@2"
				},
				{
					"command": "agentBoard.undoDone",
					"when": "view == agentBoard.sessions && viewItem =~ /done=1/",
					"group": "inline@2"
				},
				{
					"command": "agentBoard.continueLater",
					"when": "view == agentBoard.sessions && viewItem =~ /done=0.*cont=0/",
					"group": "1_actions@1"
				},
				{
					"command": "agentBoard.clearContinue",
					"when": "view == agentBoard.sessions && viewItem =~ /done=0.*cont=1/",
					"group": "1_actions@1"
				},
				{
					"command": "agentBoard.markDone",
					"when": "view == agentBoard.sessions && viewItem =~ /done=0/",
					"group": "1_actions@2"
				},
				{
					"command": "agentBoard.undoDone",
					"when": "view == agentBoard.sessions && viewItem =~ /done=1/",
					"group": "1_actions@2"
				}
			]
		},
		"configuration": {
			"title": "Agent Board",
			"properties": {
				"agentBoard.port": {
					"type": "number",
					"default": 8765,
					"description": "Port of the local Agent Board server."
				},
				"agentBoard.scriptPath": {
					"type": "string",
					"default": "",
					"description": "Script to start if the board is not running. Empty uses the service inside the installed Agent Board app."
				},
				"agentBoard.refreshSeconds": {
					"type": "number",
					"default": 10,
					"description": "How often the list refreshes."
				},
				"agentBoard.groupBy": {
					"type": "string",
					"enum": [
						"status",
						"topic"
					],
					"default": "status",
					"description": "Group the list by status, or by the topics the Agent Board service reports. The topic view keeps the statuses that need you at the top."
				},
				"agentBoard.ticketPrefixes": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"description": "Ticket prefixes to show on rows, such as ABC for ABC-1234. Empty shows any prefix."
				}
			}
		}
	}
}
